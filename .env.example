# Solana RPC endpoints (get free keys from helius.dev or quicknode.com)
SOLANA_RPC_HTTP=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_WSS=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# (Optional) Initial wallet address to monitor (base58 public key)
# You can also add wallets via Telegram commands after starting the bot
WALLET_ADDRESS=

# Telegram bot token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN

# Your Telegram chat ID (get by messaging @userinfobot or @RawDataBot on Telegram)
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# Log level (debug, info, warn, error)
LOG_LEVEL=info
